PORT=3000
HOST=127.0.0.1
# Leave unset to use a durable local embedded PostgreSQL database.
# Railway uses DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
DATA_DIR=.data/postgres
ADMIN_EMAIL=owner@center.local
ADMIN_PASSWORD=replace-with-a-strong-password
CENTER_NAME=Kumon Learning Center
CENTER_TIMEZONE=America/Los_Angeles
CENTER_LOCATION=
CENTER_OPERATING_HOURS=
# Sample records are opt-in for isolated development databases only.
SEED_DEMO=false

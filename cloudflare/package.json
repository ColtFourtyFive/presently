{
  "name": "presently",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:ui": "vite --host 127.0.0.1 --port 5174",
    "preview:local": "npm run build:client && tsx scripts/dev-local.ts",
    "build:client": "vite build",
    "build": "vite build && esbuild worker/index.ts --bundle --minify --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply CRM_DB --local",
    "measure": "tsx scripts/measure.ts",
    "install:business": "tsx scripts/install.ts",
    "recovery": "tsx scripts/recovery.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "hono": "^4.12.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.0"
  },
  "description": "Student check-in and check-out for Kumon centers, installed into the customer\u2019s own Cloudflare account."
}

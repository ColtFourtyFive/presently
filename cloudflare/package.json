{
  "name": "kumon-center-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:ui": "vite --host 127.0.0.1 --port 5174",
    "preview:local": "npm run build && tsx scripts/dev-local.ts",
    "recovery": "tsx scripts/recovery.ts",
    "backup-copy": "tsx scripts/r2-backup-copy-cli.ts",
    "build": "vite build && esbuild worker/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply CRM_DB --local",
    "deploy": "npm run build && wrangler deploy",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:storage": "tsx scripts/storage-audit.ts",
    "rehearse:archive-recovery": "tsx scripts/archive-scale-recovery.ts",
    "installation": "tsx scripts/install.ts",
    "handover": "tsx scripts/handover-cli.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "hono": "^4.12.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.0"
  }
}

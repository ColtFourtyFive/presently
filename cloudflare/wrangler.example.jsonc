// Example configuration for local development. Customer installations get a
// generated configuration from `npm run install:business` (docs/installation.md),
// stored outside this repository.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presently-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-11",
  "minify": true,
  "upload_source_maps": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "CRM_DB", "database_name": "presently-dev-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "presently-dev-backups" }],
  "queues": {
    "producers": [{ "binding": "BACKUP_QUEUE", "queue": "presently-dev-backups" }],
    "consumers": [{ "queue": "presently-dev-backups", "max_batch_size": 1, "max_retries": 5, "max_concurrency": 1 }]
  },
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "dev",
    "ACCESS_ISSUER": "https://YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR_ACCESS_APPLICATION_AUDIENCE",
    "BOOTSTRAP_OWNER_EMAIL": "owner@example.com",
    "BACKUP_ENABLED": "false",
    "CF_ACCOUNT_ID": "YOUR_ACCOUNT_ID",
    "CF_DATABASE_ID": "00000000-0000-0000-0000-000000000000"
  },
  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  //   PIN_PEPPER          32+ random characters; keys every kiosk PIN hash
  //   BACKUP_KEY          base64 32-byte recovery key; the owner keeps a copy
  //   CF_D1_EXPORT_TOKEN  API token limited to "D1: Edit" on this account
  //   BACKUP_ALERT_URL    optional HTTPS webhook for backup failure alerts
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
